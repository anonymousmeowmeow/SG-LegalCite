#!/bin/bash
#PBS -N gen_paragraph_pools_v2
#PBS -l select=1:ncpus=4:ngpus=0:mem=32gb
#PBS -l walltime=01:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o generate_stage2_paragraph_pools_v2.log

echo "=========================================="
echo "SG-LegalCite: Generate Stage 2 Paragraph-Augmented Ablation V2 Pools"
echo "Task: [FACT] Fact [PARAGRAPH] Scrubbed Paragraph Window → Cited Case"
echo "Pool: 1 correct case + 999 random negatives"
echo "Evaluated at (fact, principle, cited_case) triple level"
echo "Dedup key matches single_stage_pools_v2 — IDENTICAL test pools"
echo "Ground truth fields used directly (no Stage 1)"
echo ""
echo "Purpose: Reviewer 3 ablation — does the principle field add signal"
echo "beyond raw citation-proximal text? Apples-to-apples comparison"
echo "against single_stage_pools_v2 results."
echo ""
echo "Started: $(date)"
echo "=========================================="

cd $PBS_O_WORKDIR

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python generate_stage2_paragraph_pools_v2.py

echo "Finished: $(date)"
