#!/bin/bash
#PBS -N sbert_single_v1
#PBS -l select=1:ncpus=28:ngpus=7:mem=175gb:host=aimc-gna2
#PBS -l walltime=24:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o sbert_single_stage_v1.log

echo "=========================================="
echo "SG-LegalCite Single Stage — SBERT V1"
echo "Model: sentence-transformers/all-mpnet-base-v2"
echo "Task: [FACT] Fact + [PRINCIPLE] Ground Truth Principle → Cited Case"
echo "Zero-Shot + Fine-Tuned SBERT"
echo "Pool: SAME as Legal BERT — stage2_single_stage_pools.json"
echo "9979 pools — one per (fact, principle, cited_case) triple"
echo "Started: $(date)"
echo "=========================================="
echo "Config: BATCH=64, EPOCHS=10, LR=2e-5"
echo "GPUs: 7 x A100"

cd $PBS_O_WORKDIR
nvidia-smi --query-gpu=index,name,memory.total --format=csv

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python sbert_single_stage_v1.py

echo "Finished: $(date)"
