#!/bin/bash
#PBS -N roberta_lg_single_v1
#PBS -l select=1:ncpus=28:ngpus=7:mem=175gb:host=aimc-gna2
#PBS -l walltime=24:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o roberta_large_single_stage_v1.log

echo "=========================================="
echo "SG-LegalCite Stage 2 Single Stage — Legal-en-RoBERTa Large"
echo "Model: joelniklaus/legal-english-roberta-large (RoBERTa-Large, 337M params)"
echo "Architecture: 24 layers, 1024 hidden"
echo "Pre-training: 292GB+ MultiLegalPile (US, EU, UK, Canada)"
echo "Task: [FACT] Fact + [PRINCIPLE] Ground Truth Principle → Cited Case"
echo "Zero-Shot + Fine-Tuned"
echo "Pool: SAME as all models — stage2_single_stage_pools.json"
echo "9979 pools — one per (fact, principle, cited_case) triple"
echo "Note: Same settings as Legal BERT / SBERT / Custom Legal-BERT / Legal-Longformer / Pile-of-Law / SAILER"
echo "Started: $(date)"
echo "=========================================="
echo "Config: BATCH=64, EPOCHS=10, LR=2e-5, POOLING=mean, num_workers=4, pin_memory=True"
echo "GPUs: 7 x A100 | Host: aimc-gna2"

cd $PBS_O_WORKDIR
nvidia-smi --query-gpu=index,name,memory.total --format=csv

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python roberta_large_single_stage_v1.py

echo "Finished: $(date)"
