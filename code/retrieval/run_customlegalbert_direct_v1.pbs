#!/bin/bash
#PBS -N custombert_direct_v1
#PBS -l select=1:ncpus=28:ngpus=7:mem=175gb:host=aimc-gna2
#PBS -l walltime=24:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o customlegalbert_direct_v1.log

echo "=========================================="
echo "SG-LegalCite Stage 2 Direct Baseline — Custom Legal-BERT"
echo "Model: casehold/custom-legalbert (37GB Harvard Law corpus)"
echo "Task: Facts → Cited Case (no key principles)"
echo "Zero-Shot + Fine-Tuned"
echo "Pool: SAME as all models — stage2_direct_candidate_pools_v2.json"
echo "9942 pools — one per (fact, cited_case) pair"
echo "Started: $(date)"
echo "=========================================="
echo "Config: BATCH=64, EPOCHS=10, LR=2e-5, POOLING=mean"
echo "GPUs: 7 x A100"

cd $PBS_O_WORKDIR
nvidia-smi --query-gpu=index,name,memory.total --format=csv

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python customlegalbert_direct_v1.py

echo "Finished: $(date)"
