#!/bin/bash
#PBS -N sbert_direct_v2v5
#PBS -l select=1:ncpus=28:ngpus=7:mem=175gb:host=aimc-gna2
#PBS -l walltime=24:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o sbert_direct_v2v5.log

echo "=========================================="
echo "SG-LegalCite Stage 2 Direct Baseline — SBERT V2V5"
echo "Model: sentence-transformers/all-mpnet-base-v2"
echo "Task: Facts → Cited Case (no key principles)"
echo "Zero-Shot + Fine-Tuned SBERT"
echo "Pool: SAME as Legal BERT — stage2_direct_candidate_pools_v2.json"
echo "9942 pools — one per (fact, cited_case) pair"
echo "Fix: added datasets package to pip install"
echo "Started: $(date)"
echo "=========================================="
echo "Config: BATCH=64, EPOCHS=10, LR=2e-5"
echo "GPUs: 7 x A100"

cd $PBS_O_WORKDIR
nvidia-smi --query-gpu=index,name,memory.total --format=csv

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python sbert_direct_v2v5.py

echo "Finished: $(date)"
