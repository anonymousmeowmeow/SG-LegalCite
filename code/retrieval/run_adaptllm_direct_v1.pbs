#!/bin/bash
#PBS -N adaptllm_direct_v1
#PBS -l select=1:ncpus=28:ngpus=7:mem=200gb:host=aimc-gna2
#PBS -l walltime=48:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o adaptllm_direct_v1.log

echo "=========================================="
echo "SG-LegalCite Stage 2 Direct Baseline — AdaptLLM law-LLM"
echo "Model: AdaptLLM/law-LLM (LLaMA-1-7B + legal domain continued pre-training)"
echo "Reference: AdaptLLM: Adapting Large Language Models via Reading Comprehension (ICLR 2024)"
echo "Task: Facts → Cited Case (no key principles)"
echo "Zero-Shot + Fine-Tuned (QLoRA)"
echo "Pool: SAME as all models — stage2_direct_candidate_pools_v2.json"
echo "9942 pools — one per (fact, cited_case) pair"
echo "NOTE: device_map=auto required for QLoRA (cannot use DataParallel with 4-bit)"
echo "All other settings identical to encoder models for fair comparison"
echo "Started: $(date)"
echo "=========================================="
echo "Config: BATCH=64, EPOCHS=10, LR=2e-5, WARMUP=0.1, TEMP=learnable(0.07)"
echo "QLoRA: 4-bit NF4, LoRA r=16 alpha=32 | num_workers=4, pin_memory=True"
echo "GPUs: 7 x A100 | Host: aimc-gna2"

cd $PBS_O_WORKDIR
nvidia-smi --query-gpu=index,name,memory.total --format=csv

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python adaptllm_direct_v1.py

echo "Finished: $(date)"
