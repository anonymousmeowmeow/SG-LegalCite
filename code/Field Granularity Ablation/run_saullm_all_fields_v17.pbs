#!/bin/bash
#PBS -N saullm_all_fields_v17
#PBS -l select=1:ncpus=8:ngpus=2:mem=60gb
#PBS -l walltime=100:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o saullm_all_fields_v17.log

echo "============================================================"
echo "SaulLM-7B All Fields v17 (Ablation, 2 GPUs)"
echo "------------------------------------------------------------"
echo "Task:    [FACT] Facts + [ISSUE_GROUP] Issue Group + [ISSUE] Issue + [PRINCIPLE] Principle -> Cited Case"
echo "Pool:    stage2_all_fields_pools_v3.json (9979 pools)"
echo "Split:   By URL (identical to all other models)"
echo "Batch:   64 | Epochs: 10 (early stopping patience=3) | LR: 2e-5 | Warmup: 0.1"
echo "Temp:    learnable, init=0.07"
echo "QLoRA:   r=16, alpha=32, dropout=0.1 (fine-tuned only)"
echo "Attn:    SDPA (flash_attn mocked - broken in container)"
echo "GPUs:    2x A100 (per-user a100q max_run_res.ngpus = 2)"
echo "Parts:   Zero-Shot eval (no LoRA/projection) -> Fine-Tuning -> Fine-Tuned eval"
echo "v17:     device_map=auto with 4 GPUs to spread memory; v14 OOM'd on shared GPU"
echo "Started: $(date)"
echo "============================================================"

cd $PBS_O_WORKDIR
echo "Working dir: $(pwd)"
echo ""
nvidia-smi --query-gpu=index,name,memory.total --format=csv
echo ""

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python saullm_all_fields_v17.py

echo ""
echo "============================================================"
echo "Finished: $(date)"
echo "============================================================"
