#!/bin/bash
#PBS -N saullm_fact_issue_group_v1
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=100:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o saullm_fact_issue_group_v1.log

echo "============================================================"
echo "SaulLM-7B Fact+Issue Group Ablation v1 (1 GPU)"
echo "------------------------------------------------------------"
echo "Task:    [FACT] Facts + [ISSUE_GROUP] Issue Group -> Cited Case"
echo "Pool:    stage2_fact_issue_group_pools_v1.json (9979 pools)"
echo "Split:   By URL (identical to all other models)"
echo "Batch:   64 | Epochs: 10 (early stopping patience=3) | LR: 2e-5 | Warmup: 0.1"
echo "Temp:    learnable, init=0.07"
echo "QLoRA:   r=16, alpha=32, dropout=0.1 (fine-tuned only)"
echo "Attn:    SDPA (flash_attn mocked - broken in container)"
echo "GPUs:    1x A100 (running concurrently with saullm_fact_issue_v1)"
echo "Parts:   Zero-Shot eval (no LoRA/projection) -> Fine-Tuning -> Fine-Tuned eval"
echo ""
echo "Purpose: Reviewer 3 ablation matrix completion."
echo "         Compare against SaulLM fact+principle (38.2) and fact+issue (TBD)"
echo "         to test if coarser issue_group provides similar signal."
echo "Started: $(date)"
echo "============================================================"

cd $PBS_O_WORKDIR
echo "Working dir: $(pwd)"
echo ""
nvidia-smi --query-gpu=index,name,memory.total --format=csv
echo ""

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python saullm_fact_issue_group_v1.py

echo ""
echo "============================================================"
echo "Finished: $(date)"
echo "============================================================"
