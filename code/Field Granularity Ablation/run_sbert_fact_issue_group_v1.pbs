#!/bin/bash
#PBS -N sbert_fact_issue_group_v1
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=100:00:00
#PBS -q a100q
#PBS -j oe
#PBS -o sbert_fact_issue_group_v1.log

echo "============================================================"
echo "SBERT Fact+Issue Group Ablation v1 (1 GPU)"
echo "------------------------------------------------------------"
echo "Task:    [FACT] Facts + [ISSUE_GROUP] Issue Group -> Cited Case"
echo "Model:   sentence-transformers/all-mpnet-base-v2"
echo "Pool:    stage2_fact_issue_group_pools_v1.json (9979 pools)"
echo "Split:   By URL (identical to all other models)"
echo "Batch:   64 | Epochs: 10 | LR: 2e-5 | Warmup: 0.1"
echo "GPU:     1x A100"
echo "Parts:   Zero-Shot eval -> Fine-Tuning -> Fine-Tuned eval"
echo ""
echo "Purpose: Reviewer 3 ablation matrix. SBERT comparisons so far:"
echo "         - fact-only         MRR=10.5  [from paper]"
echo "         - fact+issue        MRR=20.77 [done]"
echo "         - fact+issue_group  ???       [THIS RUN]"
echo "         - fact+principle    MRR=20.9  [from paper]"
echo "         - fact+all_fields   MRR=26.34 [done]"
echo "         Tests if issue_group (coarsest doctrinal category) provides signal"
echo "Started: $(date)"
echo "============================================================"

cd $PBS_O_WORKDIR
echo "Working dir: $(pwd)"
echo ""

echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
nvidia-smi --query-gpu=index,name,memory.total --format=csv
echo ""

singularity exec --nv /app/singularity/images/pytorch_25.01-py3.sif \
    python sbert_fact_issue_group_v1.py

echo ""
echo "============================================================"
echo "Finished: $(date)"
echo "============================================================"
